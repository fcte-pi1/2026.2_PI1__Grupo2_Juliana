# Copie para .env (cp .env.example .env) e troque a senha.
# O .env nunca deve ser versionado. Não use "%" na senha (o Alembic interpreta esse caractere).
POSTGRES_USER=micromouse
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=micromouse
DATABASE_URL=postgresql+psycopg://micromouse:troque_esta_senha@localhost:5432/micromouse
